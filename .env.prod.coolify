# ==============================================================================
# .env.prod.coolify — Variables d'environnement à renseigner dans l'UI Coolify v4
# ==============================================================================
# Clé secrète Django (générée via ./scripts/generate-secrets.ps1)
SECRET_KEY=

# Domaines autorisés (séparés par une virgule)
ALLOWED_HOSTS=

# Origines de confiance pour la protection CSRF (inclure https://)
CSRF_TRUSTED_ORIGINS=

# Identifiants de la base de données PostGIS
DB_NAME=uad_sig_db
DB_USER=geofoncier_user
DB_PASSWORD=
