# ==============================================================================
# .env.dev.example — Modèle d'environnement pour le développement local
# Copié automatiquement vers .env.dev par scripts/launch-dev.ps1 / .sh
# ==============================================================================
ENVIRONMENT=local
DEBUG=True
SECRET_KEY=django-insecure-geofoncier-dev-secret-key-change-in-production-12345
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,app
CSRF_TRUSTED_ORIGINS=http://localhost:8010,http://127.0.0.1:8010,http://localhost:8000,http://127.0.0.1:8000

# Base de données PostgreSQL + PostGIS (service 'db' dans docker-compose.dev.yaml)
DB_NAME=uad_sig_db
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=db
DB_PORT=5432

# Ports exposés pour le dev
APP_DEV_PORT=8010
DB_DEV_PORT=5433
